PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="change-this-to-a-long-random-secret-key"

# PostgreSQL Database
# For docker-compose use: postgresql://bugsted:bugsted123@postgres:5432/bugsted
DATABASE_URL="postgresql://bugsted:bugsted123@localhost:5432/bugsted"

# Initial Administrator Account (created automatically on first startup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# SMTP Server (registration invitations & e-mail notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"

# Object Storage: MinIO or any S3-compatible provider (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, etc.)
# For local MinIO from docker-compose: S3_ENDPOINT=minio, S3_PORT=9000, S3_USE_SSL=false, S3_PATH_STYLE=true
# You can use either S3_* or MINIO_* variables.
S3_ENDPOINT="minio"
S3_PORT="9000"
S3_USE_SSL="false"
S3_BUCKET="bugsted"
S3_ACCESS_KEY="bugstedadmin"
S3_SECRET_KEY="BugstedMinio123!"
S3_REGION="us-east-1"
S3_PATH_STYLE="true"

# GitHub Integration (two-way Issues sync & AI codebase inspection — optional)
GITHUB_TOKEN="your-github-personal-access-token"
GITHUB_WEBHOOK_SECRET="change-me-webhook-secret"

# AI Chat Completions Endpoint (OpenAI, Pollinations, OpenRouter, Groq, Ollama, LM Studio, LiteLLM, etc.)
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="your-ai-api-key"
# Comma-separated list of models available in the "AI Suggestion" selector
AI_MODELS="gpt-4o-mini,gpt-4o"
